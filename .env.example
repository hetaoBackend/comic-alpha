# Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
HOST=127.0.0.1
PORT=5003

# OpenAI Configuration (optional, can be set via frontend)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# GOOGLE_API_KEY=your-google-api-key-here

# ComicBrain integration (optional)
# Defaults to the embedded "./ComicBrain" workspace.
# COMICBRAIN_ROOT="/absolute/path/to/ComicBrain"

# Local public frontend server (optional)
# FRONTEND_PORT=8000
# COMIC_API_BASE_URL=http://localhost:5003/api
# COMIC_DESKTOP_PORT=18764
# COMIC_IMAGE_DIR="/absolute/path/to/images"

# Codex image reference budgeting (optional)
# CODEX_MAX_PREVIOUS_PAGE_REFERENCES=2
# CODEX_MAX_COVER_PAGE_REFERENCES=4
# CODEX_REFERENCE_MAX_SIDE=768
